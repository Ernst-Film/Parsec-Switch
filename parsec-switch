#!/bin/zsh
# parsec-switch — manage several Parsec logins on one Mac
#
# Parsec stores its login in ~/.parsec/user.bin. This script keeps a copy of
# that file per profile under ~/.parsec/profiles/<name>/ and swaps it in on
# demand (Parsec is quit and relaunched in the process).
#
#   parsec-switch              toggle to the next profile
#   parsec-switch <name>       switch to a profile
#   parsec-switch save <name>  save the current login as a profile
#   parsec-switch new          log out for a fresh login (then: save <name>)
#   parsec-switch list         list profiles
#   parsec-switch delete <name>

set -euo pipefail

PARSEC_DIR="$HOME/.parsec"
PROFILES_DIR="$PARSEC_DIR/profiles"
ACTIVE_FILE="$PROFILES_DIR/.active"
USER_BIN="$PARSEC_DIR/user.bin"
APP="/Applications/Parsec.app"
# Parsec's own daemon only — macOS ships an unrelated process with the same
# name "parsecd" (CoreParsec, Siri Suggestions) that must not be touched.
DAEMON="^$APP/Contents/MacOS/parsecd"

mkdir -p "$PROFILES_DIR"

active_profile() { [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""; }

quit_parsec() {
    if pgrep -f "$DAEMON" >/dev/null 2>&1; then
        osascript -e 'quit app "Parsec"' >/dev/null 2>&1 || true
        for i in {1..10}; do
            pgrep -f "$DAEMON" >/dev/null 2>&1 || break
            sleep 0.5
        done
        pkill -f "$DAEMON" 2>/dev/null || true
        sleep 0.5
    fi
}

start_parsec() { open "$APP"; }

# Copy the current login back into the active profile (if known)
sync_back() {
    local cur; cur=$(active_profile)
    if [[ -n "$cur" && -f "$USER_BIN" && -d "$PROFILES_DIR/$cur" ]]; then
        cp "$USER_BIN" "$PROFILES_DIR/$cur/user.bin"
    fi
}

cmd="${1:-toggle}"

case "$cmd" in
    toggle)
        # No argument: switch to the next profile (with 2 profiles = toggle)
        cur=$(active_profile)
        profiles=("$PROFILES_DIR"/*(N/))
        names=(${profiles:t})
        if (( ${#names} < 2 )); then
            echo "Toggling needs at least 2 profiles." >&2
            exec "$0" list
        fi
        target=""
        for (( i = 1; i <= ${#names}; i++ )); do
            if [[ "${names[i]}" == "$cur" ]]; then
                target="${names[$(( i % ${#names} + 1 ))]}"
                break
            fi
        done
        [[ -n "$target" ]] || target="${names[1]}"
        exec "$0" "$target"
        ;;

    list)
        cur=$(active_profile)
        echo "Profiles in $PROFILES_DIR:"
        found=0
        for d in "$PROFILES_DIR"/*(N/); do
            name=${d:t}
            marker="  "
            if [[ "$name" == "$cur" ]]; then marker="* "; fi
            echo "  ${marker}${name}"
            found=1
        done
        if [[ $found -eq 0 ]]; then
            echo "  (none — create one with 'parsec-switch save <name>')"
        fi
        ;;

    save)
        name="${2:?Missing profile name: parsec-switch save <name>}"
        [[ -f "$USER_BIN" ]] || { echo "No active login (~/.parsec/user.bin missing) — log in to Parsec first." >&2; exit 1; }
        mkdir -p "$PROFILES_DIR/$name"
        cp "$USER_BIN" "$PROFILES_DIR/$name/user.bin"
        echo "$name" > "$ACTIVE_FILE"
        echo "Saved login as profile '$name' (active)."
        ;;

    new)
        quit_parsec
        sync_back
        rm -f "$USER_BIN"
        : > "$ACTIVE_FILE"
        start_parsec
        echo "Logged out — log in to Parsec again, then run: parsec-switch save <name>"
        ;;

    delete)
        name="${2:?Missing profile name: parsec-switch delete <name>}"
        [[ -d "$PROFILES_DIR/$name" ]] || { echo "Profile '$name' does not exist." >&2; exit 1; }
        rm -rf "$PROFILES_DIR/$name"
        if [[ "$(active_profile)" == "$name" ]]; then : > "$ACTIVE_FILE"; fi
        echo "Deleted profile '$name'."
        ;;

    *)
        name="$cmd"
        [[ -f "$PROFILES_DIR/$name/user.bin" ]] || {
            echo "Profile '$name' does not exist. Available profiles:" >&2
            "$0" list >&2
            exit 1
        }
        if [[ "$(active_profile)" == "$name" ]]; then
            echo "Profile '$name' is already active."
            exit 0
        fi
        quit_parsec
        sync_back
        cp "$PROFILES_DIR/$name/user.bin" "$USER_BIN"
        echo "$name" > "$ACTIVE_FILE"
        start_parsec
        echo "Switched to profile '$name'."
        ;;
esac
